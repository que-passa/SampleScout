{
	"version": 1,
	"hooks": {
		"beforeShellExecution": [
			{
				"command": "node .cursor/hooks/guard-shell.mjs",
				"failClosed": false
			}
		],
		"preToolUse": [
			{
				"command": "node .cursor/hooks/guard-write.mjs",
				"matcher": "Write|Edit|StrReplace|Delete",
				"failClosed": false
			}
		]
	}
}
