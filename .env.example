# GitHub Pages project-site base path (empty for local / user site).
# Deploy workflow sets this automatically from the repo name.
# Example production: /SampleScout
# BASE_PATH=/SampleScout

# Audiotool OAuth (public client — never put a PAT here)
PUBLIC_AUDIOTOOL_CLIENT_ID=
# Local (exact match in Audiotool developer dashboard; use 127.0.0.1, not localhost):
PUBLIC_AUDIOTOOL_REDIRECT_URL=http://127.0.0.1:5173/account
# Production Pages example (also register this URI in the Audiotool dashboard):
# PUBLIC_AUDIOTOOL_REDIRECT_URL=https://que-passa.github.io/SampleScout/account
# Space- or comma-separated. Confirm sample scopes in the Audiotool dashboard.
PUBLIC_AUDIOTOOL_SCOPES=project:write,sample:write,sample:read
